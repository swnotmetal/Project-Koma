{
  "name": "project-koma",
  "private": true,
  "type": "module",
  "version": "0.1.2",
  "description": "Production-grade defensive primitives for AI apps.",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "demo": "node demo/server.js",
    "demo:web": "node demo/web/server.mjs",
    "build": "npm run build -w koma-core -w koma-gate -w koma-scout -w koma-miko && npm run build -w koma-core-mcp -w koma-gate-mcp",
    "check": "npm run build && npm run typecheck -ws --if-present",
    "typecheck": "npm run typecheck -ws --if-present",
    "smoke:npm": "node scripts/smoke-npm.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "release:patch": "npm version patch -ws --no-git-tag-version",
    "release:minor": "npm version minor -ws --no-git-tag-version",
    "release:major": "npm version major -ws --no-git-tag-version"
  },
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "^22.13.4",
    "gif-encoder-2": "^1.0.5",
    "sharp": "^0.35.3",
    "typescript": "^5.8.3",
    "vitest": "^4.1.10"
  }
}
