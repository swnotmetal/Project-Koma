{
  "name": "koma-miko",
  "version": "0.1.0-alpha.0",
  "description": "Deterministic skill and action contract verification for AI agent workflows.",
  "author": "Shuang Wu",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": "./dist/index.js",
    "./claude-code": "./dist/claude-code.js"
  },
  "bin": {
    "koma-miko-claude-hook": "./dist/claude-hook-cli.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "eval:replay": "npm run build && node ./evals/replay.mjs",
    "eval:scale": "npm run build && node ./evals/scale.mjs",
    "eval:claude-hook": "npm run build && node ./evals/claude-hook.mjs",
    "eval:claude-live": "npm run build && node ./evals/claude-live.mjs",
    "prepack": "npm run build",
    "prepublishOnly": "npm run build"
  },
  "files": [
    "dist",
    "evals",
    "examples",
    "src",
    "README.md",
    "README.zh-CN.md"
  ],
  "keywords": [
    "ai",
    "agents",
    "skills",
    "contracts",
    "guardrails",
    "hooks",
    "typescript"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/swnotmetal/Project-Koma"
  },
  "publishConfig": {
    "access": "public"
  },
  "homepage": "https://github.com/swnotmetal/Project-Koma#readme"
}
