{
  "name": "koma-miko",
  "version": "0.1.0-alpha.10",
  "description": "Deterministic skill and action contract verification for AI agent workflows.",
  "author": "Shuang Wu",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": "./dist/index.js",
    "./claude-code": "./dist/claude-code.js",
    "./codex": "./dist/codex.js",
    "./gemini": "./dist/gemini.js",
    "./vscode": "./dist/vscode.js",
    "./host-adapter": "./dist/host-adapter.js",
    "./config": "./dist/config.js",
    "./doctor": "./dist/doctor.js",
    "./schema": "./schema/miko.schema.json"
  },
  "bin": {
    "koma-miko": "dist/cli.js",
    "koma-miko-claude-hook": "dist/claude-hook-cli.js",
    "koma-miko-codex-hook": "dist/codex-hook-cli.js",
    "koma-miko-gemini-hook": "dist/gemini-hook-cli.js",
    "koma-miko-vscode-hook": "dist/vscode-hook-cli.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "eval:replay": "npm run build && node ./evals/replay.mjs",
    "eval:audit-demo": "npm run build && node ./evals/audit-demo.mjs",
    "eval:audit-demo:check": "npm run build && node ./evals/audit-demo.mjs --check",
    "eval:scale": "npm run build && node ./evals/scale.mjs",
    "eval:claude-hook": "npm run build && node ./evals/claude-hook.mjs",
    "eval:codex-hook": "npm run build && node ./evals/codex-hook.mjs",
    "eval:codex-live": "npm run build && node ./evals/codex-live.mjs",
    "eval:gemini-hook": "npm run build && node ./evals/gemini-hook.mjs",
    "eval:vscode-hook": "npm run build && node ./evals/vscode-hook.mjs",
    "eval:gemini-live": "npm run build && node ./evals/gemini-live.mjs",
    "eval:claude-live": "npm run build && node ./evals/claude-live.mjs",
    "eval:claude-scale-live": "npm run build && node ./evals/claude-scale-live.mjs",
    "eval:claude-scale-dry": "npm run build && node ./evals/claude-scale-live.mjs --dry-run",
    "prepack": "npm run build",
    "prepublishOnly": "npm run build"
  },
  "files": [
    "assets",
    "dist",
    "evals",
    "examples",
    "schema",
    "src",
    "README.md",
    "README.zh-CN.md"
  ],
  "keywords": [
    "ai",
    "agents",
    "skills",
    "contracts",
    "guardrails",
    "hooks",
    "typescript",
    "vscode",
    "copilot"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/swnotmetal/Project-Koma.git"
  },
  "publishConfig": {
    "access": "public"
  },
  "homepage": "https://github.com/swnotmetal/Project-Koma#readme"
}
